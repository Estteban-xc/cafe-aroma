# Copia este archivo como ".env" y pega tu cadena de conexión de MongoDB Atlas.
# Si no existe .env, la app usa el archivo local data/ventas.json.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cafe_aroma

# Opcional: URL de la app publicada para registrar ventas desde la consola
# API_URL=https://cafe-aroma.vercel.app
